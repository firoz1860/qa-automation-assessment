    {
      "parameters": {
        "url": "https://api.github.com/search/repositories?q=topic:javascript&sort=stars&order=desc&per_page=10",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-github-digest"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "6fc65c95-fb96-48b1-894f-bdfb4fb76a35",
      "name": "GitHub Search Repos (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        180,
        300
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Validate the GitHub search response, keep useful fields, sort by stars, keep top 5.\nconst res = $input.first().json;\nconst items = Array.isArray(res.items) ? res.items : null;\n\n// Malformed / empty payload -> throw so this routes to the error branch (not a silent empty digest).\nif (!items || items.length === 0) {\n  throw new Error('GitHub search returned no \"items\" array (malformed or empty payload).');\n}\n\nconst mapped = items.map((r) => ({\n  full_name: r.full_name,\n  name: r.name,\n  owner: r.owner && r.owner.login ? r.owner.login : (r.full_name || '/').split('/')[0],\n  repo: r.name,\n  url: r.html_url,\n  stars: typeof r.stargazers_count === 'number' ? r.stargazers_count : 0,\n  description: r.description || 'No description provided',\n}));\n\nmapped.sort((a, b) => b.stars - a.stars);\nconst top5 = mapped.slice(0, 5);\n\nreturn [{ json: { repos: top5, top: top5[0], count: top5.length, fetched_at: new Date().toISOString() } }];\n"
      },
      "id": "87ae31f2-5ccb-4d8a-9442-ee4a4321cb93",
      "name": "Top 5 Repos (Code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ encodeURIComponent($json.top.owner) }}/{{ encodeURIComponent($json.top.repo) }}/readme",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-github-digest"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "b2916b50-9d18-4b9b-91a7-999a52c2757c",
      "name": "Enrich Top Repo README (HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Combine the top-5 list (from the Code node) with the enriched README of the top repo.\n// The README HTTP node is set to \"Continue On Error (regular output)\"; on 404 the item\n// carries an error, so we degrade gracefully to \"README unavailable\" and still ship the digest.\nconst top5 = $('Top 5 Repos (Code)').first().json;\nconst repos = top5.repos || [];\nconst top = top5.top || {};\n\nconst readme = $input.first().json || {};\nlet readmeInfo;\nif (readme.error || !readme.name) {\n  readmeInfo = 'README unavailable';\n} else {\n  const sizeKb = typeof readme.size === 'number' ? Math.round((readme.size / 1024) * 10) / 10 : null;\n  readmeInfo = 'README `' + readme.name + '`' + (sizeKb != null ? ' (~' + sizeKb + ' KB)' : '');\n}\n\nconst lines = repos.map((r, i) =>\n  (i + 1) + '. [' + r.full_name + '](' + r.url + ') — ⭐ ' + Number(r.stars).toLocaleString() +\n  '\\n    ' + String(r.description).slice(0, 120)\n);\n\nconst stamp = new Date().toISOString().slice(0, 16).replace('T', ' ');\nconst message =\n  '**Top 5 JavaScript repositories on GitHub**\\n' +\n  '_(morning brief · ' + stamp + ' UTC)_\\n\\n' +\n  lines.join('\\n') +\n  '\\n\\n🔎 Enriched top repo **' + (top.full_name || 'n/a') + '**: ' + readmeInfo;\n\nreturn [{ json: { message, top, repos, readme_info: readmeInfo } }];\n"
      },
      "id": "4d175781-a241-41ef-b013-64869d14e7a8",
      "name": "Build Digest (Code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "2286011e-7020-4cd8-9a45-0d39a333d11d",
              "leftValue": "={{ $json.top.stars }}",
              "rightValue": 1000,
