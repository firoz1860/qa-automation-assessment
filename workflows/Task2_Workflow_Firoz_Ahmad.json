    {
      "parameters": {
        "jsCode": "// Turn any upstream failure (HTTP non-2xx, timeout, rate limit, or malformed payload)\n// into a single, honest alert. We deliberately DO NOT emit an empty success digest.\nconst inItem = $input.first().json || {};\nconst err = inItem.error || inItem;\nconst message = err.message || err.description || 'Unknown error';\nconst status = err.httpCode || err.statusCode || err.status || 'n/a';\n\nconst content =\n  '🚨 **GitHub Digest workflow — FAILURE**\\n' +\n  'The morning brief could NOT be generated, so no digest was sent.\\n' +\n  '• Status: ' + status + '\\n' +\n  '• Message: ' + String(message).slice(0, 400) + '\\n' +\n  '• Time: ' + new Date().toISOString();\n\nreturn [{ json: { content, status, error_message: String(message), timestamp: new Date().toISOString() } }];\n"
      },
